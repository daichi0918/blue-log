// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id        Int        @id @default(autoincrement())
  title     String     @db.VarChar(255)
  text      String     @db.Text
  tags      String[]
  createdAt DateTime   @default(now()) @db.Timestamp(0)
  updatedAt DateTime   @updatedAt @db.Timestamp(0)
  userId    Int
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     Like[]
  bookmarks Bookmark[]
}

model User {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(255)
  email     String     @unique @db.VarChar(255)
  password  String     @db.VarChar(255)
  image     String?    @db.VarChar(255)
  twitter   String?    @db.VarChar(255)
  facebook  String?    @db.VarChar(255)
  github    String?    @db.VarChar(255)
  createdAt DateTime   @default(now()) @db.Timestamp(0)
  updateAt  DateTime   @updatedAt @db.Timestamp(0)
  articles  Article[]
  likes     Like[]
  bookmarks Bookmark[]
  following Follow[]   @relation("Following", fields: [], references: [])
  followers Follow[]   @relation("Followers", fields: [], references: [])
}

model Like {
  userId    Int
  articleId Int
  createdAt DateTime @default(now()) @db.Timestamp(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId]) // 複合主キー
}

model Bookmark {
  userId    Int
  articleId Int
  createdAt DateTime @default(now()) @db.Timestamp(0)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@id([userId, articleId]) // 複合主キー
}

model Follow {
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now()) @db.Timestamp(0)

  follower  User @relation("Following", fields: [followerId], references: [id])
  following User @relation("Followers", fields: [followingId], references: [id])

  @@id([followerId, followingId]) // 複合主キー
}
